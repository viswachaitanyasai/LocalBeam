<?xml version="1.0" encoding="utf-8"?>
<!--
  Foreground layer of the adaptive launcher icon: the same cast glyph the streaming
  notification uses (see `ic_stat_cast.xml`), so the app looks like itself everywhere.

  Two rules make this fit an adaptive icon:
   * a solid silhouette, because Android 13+ tints `<monochrome>` from the foreground,
   * the artwork stays inside the guaranteed-visible area. The canvas is 108x108, the
     mask shows the middle 72x72 and only a 66dp circle is always visible, so the 24x24
     glyph is scaled by 2.2 (48 units wide) and centred: its corners land 31.3 from the
     centre, inside the 33-unit safe radius.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="2.2"
        android:scaleY="2.2"
        android:translateX="27.6"
        android:translateY="27.6">
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M21,3H3C1.9,3 1,3.9 1,5v3h2V5h18v14h-7v2h7c1.1,0 2,-0.9 2,-2V5C23,3.9 22.1,3 21,3zM1,18v3h3C4,19.34 2.66,18 1,18zM1,14v2c2.76,0 5,2.24 5,5h2C8,17.13 4.87,14 1,14zM1,10v2c4.97,0 9,4.03 9,9h2C12,14.92 7.07,10 1,10z" />
    </group>
</vector>

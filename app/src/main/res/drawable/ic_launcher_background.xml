<?xml version="1.0" encoding="utf-8"?>
<!--
  Background layer of the adaptive launcher icon.

  The launcher crops this to a circle/squircle/rounded square, so it only has to cover
  the full 108x108 canvas. Flat brand colour: the app's own primary (Material purple 40,
  the seed colour `LocalBeamTheme` falls back to when dynamic colour is unavailable).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#6650A4"
        android:pathData="M0,0h108v108h-108z" />
</vector>
